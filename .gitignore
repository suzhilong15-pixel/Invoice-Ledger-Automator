# Local operating system files
.DS_Store
Thumbs.db

# Python caches and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Conda environment
.conda/
.venv/
venv/
env/

# Confidential invoice data and generated ledgers
*.pdf
*.PDF
*.xlsx
*.xls
*.csv

# Keep the workflow folders, but never commit their contents.
invoices_to_process/*
archived_invoices/*
failed_invoices/*
!invoices_to_process/.gitkeep
!archived_invoices/.gitkeep
!failed_invoices/.gitkeep

# Logs and temporary files
*.log
*.tmp
~$*
